{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "normalizer": {
        "lowercase_normalizer": {
          "type": "custom",
          "filter": ["lowercase", "icu_folding"]
        }
      },
      "filter": {
        "autocomplete_edge_ngram": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 15
        }
      },
      "analyzer": {
        "vi_folded_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding"]
        },
        "vi_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding"]
        },
        "vi_autocomplete_index_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "icu_folding", "autocomplete_edge_ngram"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "listingId": { "type": "keyword" },
      "sellerUserId": { "type": "keyword" },
      "slug": { "type": "keyword" },
      "title": {
        "type": "text",
        "analyzer": "vi_folded_analyzer",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "vi_autocomplete_index_analyzer",
            "search_analyzer": "vi_folded_analyzer"
          },
          "keyword": { "type": "keyword" }
        }
      },
      "description": { "type": "text", "analyzer": "vi_folded_analyzer" },
      "category": { "type": "keyword" },
      "brand": {
        "type": "keyword",
        "fields": {
          "normalized": {
            "type": "keyword",
            "normalizer": "lowercase_normalizer"
          }
        }
      },
      "modelName": {
        "type": "text",
        "analyzer": "vi_folded_analyzer",
        "fields": { "keyword": { "type": "keyword" } }
      },
      "conditionGrade": { "type": "keyword" },
      "priceVnd": { "type": "scaled_float", "scaling_factor": 100 },
      "allowPriceOffer": { "type": "boolean" },
      "allowSwap": { "type": "boolean" },
      "preferredSwapItems": { "type": "text", "analyzer": "vi_folded_analyzer" },
      "thumbnailUrl": { "type": "keyword", "index": false },
      "provinceCode": { "type": "keyword" },
      "districtCode": { "type": "keyword" },
      "status": { "type": "keyword" },
      "createdAt": { "type": "date" }
    }
  }
}
